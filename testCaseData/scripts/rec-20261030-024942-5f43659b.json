  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('http://10.211.55.13/GoAPI/index.php?share_code=4C88BD395D774BEFBE0DCF0189116EBB80F1A1472A6370E39DDE7B5FFCC3DF2A');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換Timestamp' }).click();\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換訂單編號' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '送出' }).click();\n  const page1 = await page1Promise;\n  await page1.getByRole('radio', { name: '超商取貨付款' }).check();\n  await page1.getByRole('radio', { name: '萊爾富' }).check();\n  const page2Promise = page1.waitForEvent('popup');\n  await page1.getByText('選擇取貨門市').click();\n  const page2 = await page2Promise;\n  await page2.locator('input[name=\"GridView1$ctl02$imgBtnDetail\"]').click();\n  await page2.locator('#btnSelSure').click();\n  await page1.getByRole('textbox').first().click();\n  await page1.getByRole('textbox').first().fill(testData('輸入資料1'));\n  await page1.getByRole('textbox').nth(1).click();\n  await page1.getByRole('textbox').nth(1).fill(testData('手機'));\n  await page1.getByRole('checkbox', { name: '我已同意並閱讀 藍新金流服務平台付款方服務條款 及 隱私權保護政策' }).check();\n  await page1.getByRole('checkbox', { name: '我已再次確認「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至E-mail信箱' }).check();\n  await page1.getByText('確認送出').click();\n});",

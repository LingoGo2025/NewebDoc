  "region_id": "production",
  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://core.newebpay.com/EPG/MS1118308/t76lRq');\n  await page.getByRole('img', { name: 'AFTEE' }).click();\n  await page.getByRole('button', { name: '超商取貨' }).click();\n  await page.getByRole('radio', { name: '-ELEVEN' }).check();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('button', { name: '選擇取貨門市' }).click();\n  const page1 = await page1Promise;\n  await page1.locator('#frmMain').contentFrame().locator('#sel_area').selectOption(testData('sel_area'));\n  await page1.locator('#frmMain').contentFrame().locator('#zone').selectOption(testData('zone'));\n  await page1.locator('#frmMain').contentFrame().locator('a').click();\n  await page1.locator('#frmMain').contentFrame().locator('#road_chosen').getByText('中華路').click();\n  await page1.locator('#frmMain').contentFrame().getByText('富華門市基隆市中山區中華路9號').click();\n  await page1.getByRole('button', { name: '門 市 確 認' }).click();\n  await page1.getByRole('button', { name: 'Submit' }).click();\n  await page1.locator('#submit_butn').click();\n  await page.locator('#PayerName').click();\n  await page.locator('#PayerName').fill(testData('姓名'));\n  await page.locator('#PayerName').press('Tab');\n  await page.locator('#PayerTel').fill(testData('電話'));\n  await page.locator('#PayerMail').click();\n  await page.locator('#PayerMail').fill(testData('Email'));\n  await page.locator('.receiver').first().check();\n  await page.getByRole('checkbox', { name: '請再次確認您的「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至您的Email信箱' }).check();\n  await page.getByRole('link', { name: '已閱讀並同意服務條款，確認送出' }).click();\n});",

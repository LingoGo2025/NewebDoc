  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('http://svc.neweb.com.tw:8888/GoAPI/index.php?share_code=8892EB09AD29819698F760C717DB33CC6DBBB6D2');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換Timestamp' }).click();\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換訂單編號' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '送出' }).click();\n  const page1 = await page1Promise;\n  await page1.getByText('超商取貨付款').click();\n  await page1.getByRole('radio', { name: '超商取貨付款' }).check();\n  const page2Promise = page1.waitForEvent('popup');\n  await page1.getByText('選擇取貨門市').click();\n  const page2 = await page2Promise;\n  await page2.locator('#frmMain').contentFrame().getByRole('listitem').filter({ hasText: '請選擇縣市 請選擇 基隆市 台北市 新北市 桃園市 新竹市 新竹縣 苗栗縣 台中市 南投縣 彰化縣 雲林縣 嘉義市 嘉義縣 台南市 高雄市 屏東縣 宜蘭縣 花蓮' }).locator('div').click();\n  await page2.locator('#frmMain').contentFrame().locator('#sel_area').selectOption(testData('sel_area'));\n  await page2.locator('#frmMain').contentFrame().locator('#zone').selectOption(testData('zone'));\n  await page2.locator('#frmMain').contentFrame().locator('a').click();\n  await page2.locator('#frmMain').contentFrame().locator('#road_chosen').getByText('中和路').click();\n  await page2.locator('#frmMain').contentFrame().getByText('新大慶門市基隆市中山區中和路168巷7弄13號15號1樓').click();\n  await page2.getByRole('button', { name: '門 市 確 認' }).click();\n  await page2.getByRole('button', { name: 'Submit' }).click();\n  await page2.locator('#submit_butn').click();\n  await page1.getByRole('textbox').first().click();\n  await page1.getByRole('textbox').first().fill(testData('輸入資料3'));\n  await page1.getByRole('textbox').nth(1).click();\n  await page1.getByRole('textbox').nth(1).fill(testData('手機'));\n  await page1.getByRole('checkbox', { name: '我已再次確認「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至E-mail信箱' }).check();\n  await page1.getByRole('checkbox', { name: '我已同意並閱讀 藍新金流服務平台付款方服務條款 及 隱私權保護政策' }).check();\n  await page1.getByText('確認送出').click();\n});",

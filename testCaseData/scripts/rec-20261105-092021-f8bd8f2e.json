  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://www.newebpay.com/');\n  await page.getByRole('link', { name: '服務列表' }).click();\n  await page.getByRole('link', { name: '快速收款連結' }).click();\n  await page.getByRole('link', { name: '線上刷卡服務' }).click();\n  await page.getByRole('link', { name: '超商代收' }).click();\n  await page.getByRole('link', { name: 'ATM / WebATM' }).click();\n  await page.getByRole('link', { name: '智慧ATM2.0' }).click();\n  await page.getByRole('link', { name: 'ezPay簡單付' }).click();\n  await page.getByRole('link', { name: 'Apple Pay' }).click();\n  await page.getByRole('link', { name: 'Google Pay' }).click();\n  await page.getByRole('link', { name: 'Samsung Pay' }).click();\n  await page.getByRole('link', { name: '台灣 Pay' }).click();\n  await page.getByRole('link', { name: '玉山Wallet' }).click();\n  await page.getByRole('link', { name: 'LINE Pay' }).click();\n  await page.getByRole('link', { name: 'AFTEE 先享後付' }).click();\n  await page.getByRole('link', { name: '大哥付你分期' }).click();\n  await page.getByRole('link', { name: 'BitoPro' }).click();\n  await page.getByRole('link', { name: '費率一覽表' }).click();\n  await page.locator('#indx_top_clooapse').getByRole('link', { name: '平台產品使用規範' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('link', { name: '超商店到店' }).click();\n  const page1 = await page1Promise;\n  const page2Promise = page1.waitForEvent('popup');\n  await page1.getByRole('link', { name: '超商大宗寄倉' }).click();\n  const page2 = await page2Promise;\n  await page2.getByRole('link', { name: '金流API' }).click();\n  const page3Promise = page2.waitForEvent('popup');\n  const downloadPromise = page2.waitForEvent('download');\n  await page2.getByRole('link', { name: '信用卡定期定額串接技術手冊_NDNP-' }).click();\n  const page3 = await page3Promise;\n  const download = await downloadPromise;\n  await page2.getByRole('navigation').getByRole('link').filter({ hasText: /^$/ }).click();\n  await page2.getByRole('link', { name: '最新消息' }).click();\n  await page2.getByRole('link', { name: '服務公告' }).click();\n  await page2.getByRole('link').first().click();\n  await page2.getByRole('link', { name: '會員服務條款' }).click();\n  await page2.getByRole('link', { name: '付款方服務條款' }).click();\n  await page2.getByRole('link', { name: '商店管理規範' }).click();\n  await page2.getByRole('link', { name: '平台產品使用規範' }).click();\n  await page2.getByRole('link', { name: '代收款信託保障' }).click();\n  await page2.getByRole('link', { name: '平台產品使用規範' }).click();\n  await page2.getByRole('link', { name: '代收款信託保障' }).click();\n  await page2.getByRole('link', { name: '隱私權保護政策' }).click();\n  await page2.getByRole('link', { name: 'API文件下載' }).click();\n});",

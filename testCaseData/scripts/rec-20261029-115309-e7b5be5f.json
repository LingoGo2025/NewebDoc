  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('http://10.211.55.13/GoAPI/index.php?share_code=232AB0D57D8091FFD9F814A36D7AD672C733C6E83BA77B2BB1A4CB84E7D72E43');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換Timestamp' }).click();\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換訂單編號' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '送出' }).click();\n  const page1 = await page1Promise;\n  await page1.getByRole('radio', { name: 'AFTEE Pay' }).check();\n  await page1.getByRole('radio', { name: '分期付款 商店負擔全額分期手續費' }).check();\n  await page1.getByRole('combobox').selectOption(testData('輸入資料1'));\n  await page1.getByRole('checkbox', { name: '我已同意並閱讀 藍新金流服務平台付款方服務條款 及 隱私權保護政策' }).check();\n  await page1.getByRole('checkbox', { name: '我已再次確認「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至E-mail信箱' }).check();\n  await page1.getByText('確認送出').click();\n});",

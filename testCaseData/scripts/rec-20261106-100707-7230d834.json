  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('http://svc.neweb.com.tw:8888/GoAPI/index.php?share_code=AA13A356E55F58CEC8C00A390D66855AF05327CBDF9B792F58BB00C045C468CC');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換Timestamp' }).click();\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換訂單編號' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '送出' }).click();\n  const page1 = await page1Promise;\n  await page1.getByRole('radio', { name: 'TWQR' }).check();\n  await page1.getByRole('checkbox', { name: '我充分理解並同意上述內容，並同意透過藍新金流轉導至' }).check();\n  await page1.getByText('確認送出').click();\n  await page1.getByText('下一步', { exact: true }).click();\n});",

  "region_id": "production",
  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('http://svc.neweb.com.tw:8888/GoAPI/index.php?share_code=3EEE7A01FC3BDD4647A91A80D799204013BD7A36132C4B8381167F36D297FEEC');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換Timestamp' }).click();\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換訂單編號' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '送出' }).click();\n  const page1 = await page1Promise;\n  await page1.getByText('信用卡分期付款').click();\n  await page1.getByRole('radio', { name: '信用卡分期付款' }).check();\n  await page1.locator('label').filter({ hasText: '萊爾富' }).click();\n  await page1.getByRole('radio', { name: '萊爾富' }).check();\n  const page2Promise = page1.waitForEvent('popup');\n  await page1.getByText('選擇取貨門市').click();\n  const page2 = await page2Promise;\n  await page2.locator('input[name=\"GridView1$ctl02$imgBtnDetail\"]').click();\n  await page2.locator('#btnSelSure').click();\n  await page1.getByRole('textbox').first().click();\n  await page1.getByRole('textbox').first().fill(testData('輸入資料1'));\n  await page1.getByRole('textbox').first().press('Tab');\n  await page1.getByRole('textbox').nth(1).fill(testData('手機'));\n  await page1.getByRole('combobox').selectOption(testData('輸入資料3'));\n  await page1.locator('#card1').click();\n  await page1.locator('#card1').fill(testData('卡號1'));\n  await page1.locator('#card2').fill(testData('卡號2'));\n  await page1.locator('#card3').fill(testData('卡號3'));\n  await page1.locator('#card4').fill(testData('卡號4'));\n  await page1.getByRole('textbox', { name: 'MM ／ YY' }).click();\n  await page1.getByRole('textbox', { name: 'MM ／ YY' }).fill(testData('有效期限'));\n  await page1.locator('input[type=\"password\"]').click();\n  await page1.locator('input[type=\"password\"]').fill(testData('卡號5'));\n  await page1.getByRole('checkbox', { name: '我已同意並閱讀 藍新金流服務平台付款方服務條款 及 隱私權保護政策' }).check();\n  await page1.getByRole('checkbox', { name: '我已再次確認「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至E-mail信箱' }).check();\n  await page1.getByText('確認送出').click();\n  await page1.goto('https://core.newebpay.com/MPG/mpg_gateway/mpg_return_url?Status=FAIL');\n});",

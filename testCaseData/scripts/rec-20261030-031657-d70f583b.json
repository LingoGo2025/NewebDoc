  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://cwww.newebpay.com/shipping/trace');\n  await page.getByRole('textbox', { name: '請輸入藍新金流交易序號 點圖更換 查詢' }).click();\n  await page.getByRole('textbox', { name: '請輸入藍新金流交易序號 點圖更換 查詢' }).fill(testData('請輸入藍新金流交易序號點圖更換查詢'));\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).click();\n  await page.locator('#captureImg').click();\n  await page.getByRole('textbox', { name: '請輸入藍新金流交易序號 點圖更換 查詢' }).click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).fill(await captcha(page.getByRole('textbox', { name: '請輸入右方驗證碼' }), { length: 5, characters: 'upper' }));\n  await page.getByRole('button', { name: '查詢' }).click();\n  await page.getByRole('cell', { name: '統一世紀 新北市中和區中正路710號1樓K棟' }).click({\n    clickCount: 3\n  });\n  await page.getByRole('cell', { name: 'MS1594548' }).click();\n  await page.getByRole('cell', { name: 'MS1594548' }).click({\n    clickCount: 3\n  });\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).click();\n});",

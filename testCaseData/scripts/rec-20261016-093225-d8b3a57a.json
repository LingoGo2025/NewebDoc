  "region_id": "testing",
  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://ccore.newebpay.com/EPG/0910/YCFdux');\n  await page.getByRole('textbox').first().click();\n  await page.getByRole('textbox').first().fill(testData('輸入資料1'));\n  await page.locator('#APPLEPAY_BTN').click();\n  await page.getByRole('button', { name: '超商取貨' }).click();\n  await page.getByRole('radio', { name: '全家' }).check();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('button', { name: '選擇取貨門市' }).click();\n  const page1 = await page1Promise;\n  await page1.getByRole('link', { name: '桃園市' }).click();\n  await page1.getByRole('link', { name: '中壢區' }).click();\n  await page1.getByRole('link', { name: '永強街' }).click();\n  await page1.getByText('全家中壢富裕店 桃園市中壢區永強街103號1樓').click();\n  await page1.getByRole('link', { name: '確定店舖' }).click();\n  await page.locator('#PayerName').click();\n  await page.locator('#PayerName').fill(testData('姓名'));\n  await page.locator('#PayerTel').click();\n  await page.locator('#PayerTel').fill(testData('電話'));\n  await page.locator('#PayerMail').dblclick();\n  await page.locator('#PayerMail').fill(testData('Email'));\n  await page.getByRole('checkbox', { name: '請再次確認您的「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至您的Email信箱' }).check();\n  await page.getByRole('button', { name: '用 Apple Pay 結帳' }).click();\n});",

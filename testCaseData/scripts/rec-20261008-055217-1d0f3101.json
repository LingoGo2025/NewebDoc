  "script": "import { test, expect } from '@playwright/test';\n\ntest('test', async ({ page }) => {\n  await page.goto('https://core.newebpay.com/EPG/MS192113/hAMjiX');\n  await page.locator('#UnitPrice_Web').click();\n  await page.locator('#UnitPrice_Web').fill(testData('UnitPrice_Web'));\n  await page.getByRole('img', { name: '玉山 Wallet' }).click();\n  await page.getByRole('button', { name: '超商取貨' }).click();\n  await page.getByRole('radio', { name: '萊爾富' }).check();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('button', { name: '選擇取貨門市' }).click();\n  const page1 = await page1Promise;\n  await page1.locator('input[name=\"GridView1$ctl02$imgBtnDetail\"]').click();\n  await page1.locator('#btnSelSure').click();\n  await page.locator('#PayerName').click();\n  await page.locator('#PayerName').fill(testData('姓名'));\n  await page.locator('#PayerName').press('Tab');\n  await page.locator('#PayerTel').fill(testData('電話'));\n  await page.locator('select[name=\"City\"]').selectOption(testData('City'));\n  await page.locator('#PayerAddrTemp').click();\n  await page.locator('#PayerAddrTemp').fill(testData('地址'));\n  await page.locator('#PayerMail').click();\n  await page.locator('#PayerMail').fill(testData('Email'));\n  await page.getByRole('radio').nth(5).check();\n  await page.getByRole('checkbox', { name: '請再次確認您的「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至您的Email信箱' }).check();\n  await page.getByRole('link', { name: '已閱讀並同意服務條款，確認送出' }).click();\n  await page.getByRole('link', { name: '回到商店購物車' }).click();\n});",

  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://core.newebpay.com/EPG/cc01/ITAt3J');\n  await page.getByRole('link', { name: '一次付清' }).click();\n  await page.locator('#number1').fill(testData('卡號1'));\n  await page.locator('#number2').fill(testData('卡號2'));\n  await page.locator('#number3').fill(testData('卡號3'));\n  await page.locator('#number4').fill(testData('卡號4'));\n  await page.getByRole('textbox', { name: 'MM/YY' }).click();\n  await page.getByRole('textbox', { name: 'MM/YY' }).fill(testData('有效期限'));\n  await page.locator('#cvc').click();\n  await page.locator('#cvc').fill(testData('安全碼'));\n  await page.locator('#PayerName').click();\n  await page.locator('#PayerName').fill(testData('姓名'));\n  await page.locator('#PayerName').press('Tab');\n  await page.locator('#PayerTel').fill(testData('電話'));\n  await page.locator('#PayerMail').click();\n  await page.locator('#PayerMail').fill(testData('Email'));\n  await page.getByRole('radio').nth(2).check();\n  await page.getByRole('checkbox', { name: '請再次確認您的「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至您的Email信箱' }).check();\n  await page.getByRole('link', { name: '已閱讀並同意服務條款，確認送出' }).click();\n  await page.goto('https://webauthen.nccc.com.tw/acsn2_kernel/2/browser/challenge-request');\n});",

  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://cwww.newebpay.com/main/login_center/single_login');\n  await page.getByRole('textbox', { name: '帳號' }).click();\n  await page.getByRole('textbox', { name: '帳號' }).fill(testData('帳號'));\n  await page.getByRole('textbox', { name: '帳號' }).press('Tab');\n  await page.getByRole('textbox', { name: '密碼' }).fill(testData('密碼'));\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).fill(await captcha(page.getByRole('textbox', { name: '請輸入右方驗證碼' }), { length: 5, characters: 'upper' }));\n  page.once('dialog', dialog => {\n    console.log(`Dialog message: ${dialog.message()}`);\n    dialog.accept().catch(() => {});\n  });\n  await page.getByRole('button', { name: '個人會員登入' }).click();\n  await page.goto('https://cwww.newebpay.com/sale/Sell_center/search_transaction');\n  await page.getByRole('button', { name: '開始查詢' }).click();\n  await page.getByRole('link', { name: '信用卡交易專用查詢' }).click();\n  await page.getByRole('button', { name: '開始查詢' }).click();\n  await page.getByRole('link', { name: 'ATM交易查詢' }).click();\n  await page.getByRole('button', { name: '開始查詢' }).click();\n  await page.getByRole('link', { name: '跨境交易查詢' }).click();\n  page.once('dialog', dialog => {\n    console.log(`Dialog message: ${dialog.message()}`);\n    dialog.accept().catch(() => {});\n  });\n  await page.getByRole('button', { name: '開始查詢' }).click();\n  await page.getByRole('link', { name: '電子錢包專用交易查詢' }).click();\n  await page.getByRole('button', { name: '開始查詢' }).click();\n  await page.getByRole('link', { name: 'BNPL交易查詢' }).click();\n  await page.getByRole('button', { name: '開始查詢' }).click();\n  await page.getByRole('link', { name: '會員中心' }).click();\n  await page.getByRole('link', { name: '基本資料設定' }).click();\n  await page.getByRole('link', { name: '登出' }).click();\n});",

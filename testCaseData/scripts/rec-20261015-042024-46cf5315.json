  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://www.travelinvoice.com.tw/etravel/login');\n  await page.getByRole('textbox', { name: '公司統一編號' }).click();\n  await page.getByRole('textbox', { name: '公司統一編號' }).fill(testData('公司統一編號'));\n  await page.getByRole('textbox', { name: 'E-mail帳號' }).click();\n  await page.getByRole('textbox', { name: 'E-mail帳號' }).fill(testData('Email'));\n  await page.getByRole('textbox', { name: '密碼' }).click();\n  await page.getByRole('textbox', { name: '密碼' }).fill(testData('密碼'));\n  await page.locator('#login_form').getByText('更換一組').click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).fill(await captcha(page.getByRole('textbox', { name: '請輸入右方驗證碼' }), { length: 5, characters: 'digits' }));\n  await page.getByRole('button', { name: '登入' }).click();\n  await page.getByRole('button', { name: '下次變更' }).click();\n  await page.getByRole('link', { name: '登出' }).click();\n});",

  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://www.newebpay.com/');\n  await page.getByRole('link', { name: '微型商店' }).click();\n  await page.getByRole('link', { name: '快速收款連結' }).click();\n  await page.getByRole('link', { name: '線上刷卡服務' }).click();\n  await page.getByRole('link', { name: '超商代收' }).click();\n  await page.getByRole('link', { name: 'ATM / WebATM' }).click();\n  await page.getByRole('link', { name: '智慧ATM2.0' }).click();\n  await page.getByRole('link', { name: 'ezPay簡單付' }).click();\n  await page.getByRole('link', { name: 'ezPay簡單付', exact: true }).click();\n  await page.getByRole('link', { name: 'Apple Pay' }).click();\n  await page.getByRole('link', { name: 'Google Pay' }).click();\n  await page.getByRole('link', { name: 'Samsung Pay' }).click();\n  await page.getByRole('link', { name: '台灣 Pay' }).click();\n  await page.getByRole('link', { name: '玉山Wallet' }).click();\n  await page.getByRole('link', { name: 'LINE Pay' }).click();\n  await page.getByRole('link', { name: 'AFTEE 先享後付' }).click();\n  await page.getByRole('link', { name: '大哥付你分期' }).click();\n  await page.getByRole('link', { name: 'BitoPay' }).click();\n  await page.getByRole('link', { name: '費率一覽表' }).click();\n  await page.locator('#indx_top_clooapse').getByRole('link', { name: '平台產品使用規範' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('link', { name: '超商店到店' }).click();\n  const page1 = await page1Promise;\n  const page2Promise = page1.waitForEvent('popup');\n  await page1.getByRole('link', { name: '超商大宗寄倉' }).click();\n  const page2 = await page2Promise;\n  await page2.getByRole('link', { name: '金流API' }).click();\n  const page3Promise = page2.waitForEvent('popup');\n  const downloadPromise = page2.waitForEvent('download');\n  await page2.getByRole('link', { name: '線上交易─幕前支付技術串接手冊_NDNF-' }).click();\n  const page3 = await page3Promise;\n  const download = await downloadPromise;\n  await page2.getByRole('navigation').getByRole('link').filter({ hasText: /^$/ }).click();\n  await page2.getByRole('link', { name: '免費購物車模組' }).click();\n  await page2.locator('#myTab > li:nth-child(4) > a').click();\n  await page2.locator('.col-lg-3.col-xs-3.iconLi > a').click();\n});",

  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://www.travelinvoice.com.tw/');\n  await page.getByRole('link', { name: '關於藍新 關於藍新' }).click();\n  await page.getByRole('link', { name: '服務條款 服務條款' }).click();\n  await page.getByRole('link', { name: '隱私權說明 隱私權說明' }).click();\n  await page.getByRole('link', { name: '異業結盟 異業結盟' }).click();\n  await page.getByRole('link').first().click();\n  await page.getByText('開通', { exact: true }).click();\n  await page.locator('#top-bar button').click();\n  await page.getByRole('link', { name: '登入' }).click();\n  await page.locator('#menu_btn').click();\n  await page.getByRole('link', { name: '客服中心' }).click();\n  await page.getByRole('link', { name: '函令專區' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('link', { name: '觀看完整檔案1' }).nth(3).click();\n  const page1 = await page1Promise;\n  await page.getByRole('link', { name: '問與答' }).click();\n  await page.locator('a').filter({ hasText: 'Q1：需要哪種資格才能使用這個加值服務平台?' }).click();\n  await page.locator('a').filter({ hasText: 'Q2：要使用《旅行業代收轉付電子收據加值服務平台》，事前需要做些甚麼準備?' }).click();\n  await page.locator('a').filter({ hasText: 'Q2：是否有限制瀏覽器？' }).click();\n  await page.locator('a').filter({ hasText: 'Q3：消費者要如何知道已開立之收據內容?' }).click();\n  await page.getByRole('link', { name: '教學影片' }).click();\n  await page.getByRole('link', { name: '服務公告' }).click();\n  await page.getByRole('link', { name: '提交建議' }).click();\n  await page.locator('#menu_btn').click();\n  await page.getByRole('link', { name: '下載專區' }).click();\n  const page2Promise = page.waitForEvent('popup');\n  const downloadPromise = page.waitForEvent('download');\n  await page.getByRole('link', { name: '平台操作手冊' }).click();\n  const page2 = await page2Promise;\n  const download = await downloadPromise;\n  const page3Promise = page.waitForEvent('popup');\n  const download1Promise = page.waitForEvent('download');\n  await page.getByRole('link', { name: '工商憑證驗證程式' }).click();\n  const page3 = await page3Promise;\n  const download1 = await download1Promise;\n  await page.getByRole('button', { name: '展開 ' }).click();\n  const page4Promise = page.waitForEvent('popup');\n  await page.getByRole('button', { name: '開啟文件 ' }).click();\n  const page4 = await page4Promise;\n  await page.locator('#menu_btn').click();\n  await page.getByRole('link', { name: '最新消息' }).click();\n  await page.locator('#menu_btn').click();\n  await page.getByRole('link', { name: '查詢專區' }).click();\n});",

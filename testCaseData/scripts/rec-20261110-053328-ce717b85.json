  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://cwww.newebpay.com/main/login_center/single_login');\n  await page.getByRole('link', { name: '企業會員登入' }).click();\n  await page.getByRole('textbox', { name: '公司統一編號' }).click();\n  await page.getByRole('textbox', { name: '公司統一編號' }).fill(testData('電話'));\n  await page.getByRole('textbox', { name: '公司統一編號' }).press('Tab');\n  await page.getByRole('textbox', { name: '管理者帳號' }).fill(testData('管理者帳號'));\n  await page.getByRole('textbox', { name: '管理者帳號' }).press('Tab');\n  await page.getByRole('textbox', { name: '管理者密碼' }).fill(testData('密碼'));\n  await page.locator('#com_captcha').click();\n  await page.getByRole('textbox', { name: '輸入驗證碼' }).click();\n  await page.getByRole('textbox', { name: '輸入驗證碼' }).fill(await captcha(page.getByRole('textbox', { name: '輸入驗證碼' }), { length: 5, characters: 'upper' }));\n  await page.getByRole('button', { name: '企業會員登入' }).click();\n  await page.getByRole('button', { name: '下次變更' }).click(); // [可能不出現 5 秒]\n  await page.getByRole('link', { name: '會員中心' }).click();\n  await page.getByRole('link', { name: '基本資料設定' }).click();\n  await page.getByRole('link', { name: '登出' }).click();\n});",

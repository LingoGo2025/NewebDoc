  "region_id": "testing",
  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://cwww.newebpay.com/main/login_center/single_login');\n  await page.getByRole('textbox', { name: '帳號' }).click();\n  await page.getByRole('textbox', { name: '帳號' }).fill(testData('帳號'));\n  await page.getByRole('textbox', { name: '密碼' }).click();\n  await page.getByRole('textbox', { name: '密碼' }).fill(testData('密碼'));\n  await page.locator('#person_captcha').click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).fill(await captcha(page.getByRole('textbox', { name: '請輸入右方驗證碼' }), { length: 1, characters: 'upper' }));\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).press('Home');\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).fill(await captcha(page.getByRole('textbox', { name: '請輸入右方驗證碼' }), { length: 3, characters: 'upper' }));\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).press('ArrowRight');\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).fill(await captcha(page.getByRole('textbox', { name: '請輸入右方驗證碼' }), { length: 5, characters: 'upper' }));\n  await page.getByRole('button', { name: '個人會員登入' }).click();\n  await page.getByRole('button', { name: '開始查詢' }).click();\n  await page.getByRole('link', { name: '交易查詢', exact: true }).click();\n  await page.getByRole('link', { name: '會員中心' }).click();\n  await page.getByRole('link', { name: '基本資料設定' }).click();\n  await page.getByRole('link', { name: '登出' }).click();\n});",

  "region_id": "testing",
  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://ccore.newebpay.com/EPG/0910/YCFdux');\n  await page.getByRole('img', { name: '大哥付 | 你分期' }).click();\n  await page.getByRole('button', { name: '超商取貨' }).click();\n  await page.locator('#CVSCOM1').getByText('萊爾富').click();\n  await page.getByRole('radio', { name: '萊爾富' }).check();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('button', { name: '選擇取貨門市' }).click();\n  const page1 = await page1Promise;\n  await page1.locator('input[name=\"GridView1$ctl02$imgBtnDetail\"]').click();\n  await page1.locator('#btnSelSure').click();\n  await page.getByText('同付款人').click();\n  await page.locator('#PayerName').click();\n  await page.locator('#PayerName').fill(testData('姓名'));\n  await page.locator('#PayerTel').click();\n  await page.locator('#PayerTel').fill(testData('電話'));\n  await page.locator('#PayerMail').click();\n  await page.locator('#PayerMail').fill(testData('Email'));\n  await page.getByRole('checkbox', { name: '請再次確認您的「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至您的Email信箱' }).check();\n  page.once('dialog', dialog => {\n    console.log(`Dialog message: ${dialog.message()}`);\n    dialog.accept().catch(() => {});\n  });\n  await page.getByRole('link', { name: '已閱讀並同意服務條款，確認送出' }).click();\n  await page.getByRole('textbox').first().click();\n  await page.getByRole('textbox').first().fill(testData('輸入資料4'));\n  await page.getByText('：', { exact: true }).first().click();\n  await page.getByRole('link', { name: '已閱讀並同意服務條款，確認送出' }).click();\n  await page.getByRole('button', { name: '送出開始付款' }).click();\n});",

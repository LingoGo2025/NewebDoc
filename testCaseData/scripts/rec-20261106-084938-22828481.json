  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('http://svc.neweb.com.tw:8888/GoAPI/index.php?share_code=6AF835198C3C5FCC4864A4815B5F2467406F151CA4F32456B2DAF31983A8F9E9');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換Timestamp' }).click();\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換訂單編號' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '送出' }).click();\n  const page1 = await page1Promise;\n  await page1.getByRole('radio', { name: 'AFTEE Pay' }).check();\n  await page1.getByRole('checkbox', { name: '我已再次確認「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至E-mail信箱' }).check();\n  await page1.getByRole('checkbox', { name: '我已同意並閱讀 藍新金流服務平台付款方服務條款 及 隱私權保護政策' }).check();\n  await page1.getByText('確認送出').click();\n  await page1.locator('iframe[name=\"authentication-form-iframe\"]').contentFrame().getByRole('textbox', { name: '000 000' }).click();\n  await page1.locator('iframe[name=\"authentication-form-iframe\"]').contentFrame().getByRole('textbox', { name: '000 000' }).fill(testData('000000'));\n  await page1.locator('iframe[name=\"authentication-form-iframe\"]').contentFrame().getByRole('button', { name: '認證' }).click();\n});",

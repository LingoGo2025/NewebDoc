  "region_id": "testing",
  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('http://svc.neweb.com.tw:8888/GoAPI/index.php?share_code=1DE62D383BFDD6485445CD505F95FAE0423262C1AB7FEAA565676A86EC35ED91');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換Timestamp' }).click();\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '換訂單編號' }).click();\n  const page1Promise = page.waitForEvent('popup');\n  await page.locator('iframe[name=\"goAPI_iframe\"]').contentFrame().getByRole('button', { name: '送出' }).click();\n  const page1 = await page1Promise;\n  await page1.getByRole('radio', { name: '超商取貨付款' }).check();\n  await page1.locator('label').filter({ hasText: '全家' }).click();\n  await page1.getByRole('radio', { name: '全家' }).check();\n  const page2Promise = page1.waitForEvent('popup');\n  await page1.getByText('選擇取貨門市').click();\n  const page2 = await page2Promise;\n  await page2.getByRole('link', { name: '台北市' }).click();\n  await page2.getByRole('link', { name: '信義區' }).click();\n  await page2.getByRole('link', { name: '大道路' }).click();\n  await page2.getByText('全家大道店 台北市信義區大道路79號').click();\n  await page2.getByRole('link', { name: '確定店舖' }).click();\n  await page1.getByRole('textbox').first().click();\n  await page1.getByRole('textbox').first().fill(testData('輸入資料1'));\n  await page1.getByRole('textbox').first().press('Tab');\n  await page1.getByRole('textbox').nth(1).fill(testData('手機'));\n  await page1.getByRole('checkbox', { name: '我已再次確認「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至E-mail信箱' }).check();\n  await page1.getByRole('checkbox', { name: '我已同意並閱讀 藍新金流服務平台付款方服務條款 及 隱私權保護政策' }).check();\n  await page1.getByText('確認送出').click();\n});",

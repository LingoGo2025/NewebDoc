  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://www.newebpay.com/main/login_center/single_login');\n  await page.getByRole('textbox', { name: '帳號' }).click();\n  await page.getByRole('textbox', { name: '帳號' }).fill(testData('帳號'));\n  await page.getByRole('textbox', { name: '帳號' }).press('Tab');\n  await page.getByRole('textbox', { name: '密碼' }).fill(testData('密碼'));\n  await page.locator('#person_captcha').click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).fill(await captcha(page.getByRole('textbox', { name: '請輸入右方驗證碼' }), { length: 5, characters: 'upper' }));\n  await page.getByRole('button', { name: '個人會員登入' }).click();\n  await page.goto('https://www.newebpay.com/sale/Sell_center/search_transaction');\n  await page.getByRole('link', { name: '登出' }).click();\n});",

  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://www.travelinvoice.com.tw/Service/searchInv');\n  await page.getByRole('textbox', { name: '請輸入代轉收據號碼' }).click();\n  await page.getByRole('textbox', { name: '請輸入代轉收據號碼' }).fill(testData('請輸入代轉收據號碼'));\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).click();\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).click();\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).fill(testData('請輸入收據日期'));\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).press('ArrowRight');\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).press('ArrowRight');\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).press('ArrowRight');\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).fill(testData('請輸入收據日期2'));\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).press('ArrowRight');\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).press('ArrowRight');\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).press('ArrowRight');\n  await page.getByRole('textbox', { name: '請輸入收據日期' }).fill(testData('請輸入收據日期3'));\n  await page.getByRole('textbox', { name: '請輸入隨機碼' }).click();\n  await page.getByRole('textbox', { name: '請輸入隨機碼' }).fill(testData('請輸入隨機碼'));\n  await page.locator('#checkcode_change').click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).click();\n  await page.getByRole('textbox', { name: '請輸入右方驗證碼' }).fill(await captcha(page.getByRole('textbox', { name: '請輸入右方驗證碼' }), { length: 5, characters: 'digits' }));\n  await page.getByRole('button', { name: '開始查詢' }).click();\n});",

  "script": "import { test, expect } from '@playwright/test';\n\ntest('test', async ({ page }) => {\n  await page.goto('https://core.newebpay.com/EPG/MS192113/hAMjiX');\n  await page.locator('#UnitPrice_Web').click();\n  await page.locator('#UnitPrice_Web').fill(testData('UnitPrice_Web'));\n  await page.getByRole('link', { name: 'ATM轉帳' }).click();\n  await page.getByText('凱基銀行', { exact: true }).click();\n  await page.getByRole('combobox', { name: '請選擇繳費銀行代碼' }).click();\n  await page.getByRole('option', { name: '華泰商業銀行' }).click();\n  await page.getByRole('textbox', { name: '請輸入繳費帳號' }).click();\n  await page.getByRole('textbox', { name: '請輸入繳費帳號' }).fill(testData('請輸入繳費帳號'));\n  await page.getByRole('button', { name: '超商取貨' }).click();\n  await page.locator('#CVSCOM1').getByText('-ELEVEN').click();\n  await page.getByRole('radio', { name: '-ELEVEN' }).check();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('button', { name: '選擇取貨門市' }).click();\n  const page1 = await page1Promise;\n  await page1.locator('#frmMain').contentFrame().locator('#sel_area').selectOption(testData('sel_area'));\n  await page1.locator('#frmMain').contentFrame().locator('#zone').selectOption(testData('zone'));\n  await page1.locator('#frmMain').contentFrame().locator('a').click();\n  await page1.locator('#frmMain').contentFrame().locator('#road_chosen').getByText('四維路').click();\n  await page1.locator('#frmMain').contentFrame().getByText('合維門市台北市大安區四維路170巷8號1樓').click();\n  await page1.getByRole('button', { name: '門 市 確 認' }).click();\n  await page1.getByRole('button', { name: 'Submit' }).click();\n  await page1.locator('#submit_butn').click();\n  await page.getByText('同付款人').click();\n  await page.locator('#PayerName').click();\n  await page.locator('#PayerName').fill(testData('姓名'));\n  await page.locator('#PayerName').press('Tab');\n  await page.locator('#PayerTel').fill(testData('電話'));\n  await page.locator('select[name=\"City\"]').selectOption(testData('City'));\n  await page.locator('#PayerAddrTemp').click();\n  await page.locator('#PayerAddrTemp').fill(testData('地址'));\n  await page.locator('#PayerMail').click();\n  await page.locator('#PayerMail').fill(testData('Email'));\n  await page.getByRole('checkbox', { name: '請再次確認您的「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至您的Email信箱' }).check();\n  await page.getByRole('link', { name: '已閱讀並同意服務條款，確認送出' }).click();\n  const page2Promise = page.waitForEvent('popup');\n  await page.getByRole('link', { name: '返回付款頁' }).click();\n  const page2 = await page2Promise;\n});",

  "region_id": "testing",
  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://ccore.newebpay.com/EPG/0910/YCFdux');\n  await page.getByRole('textbox').first().click();\n  await page.getByRole('textbox').first().fill(testData('輸入資料1'));\n  await page.getByRole('link', { name: 'ATM轉帳' }).click();\n  await page.locator('#VACC').getByRole('radio').check();\n  await page.getByRole('combobox', { name: '請選擇繳費銀行代碼' }).click();\n  await page.getByRole('option', { name: '華泰商業銀行' }).click();\n  await page.getByRole('textbox', { name: '請輸入繳費帳號' }).click();\n  await page.getByRole('textbox', { name: '請輸入繳費帳號' }).fill(testData('請輸入繳費帳號'));\n  await page.getByRole('button', { name: '超商取貨' }).click();\n  await page.getByRole('radio', { name: '全家' }).check();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('button', { name: '選擇取貨門市' }).click();\n  const page1 = await page1Promise;\n  await page1.getByRole('link', { name: '台北市' }).click();\n  await page1.getByRole('link', { name: '信義區' }).click();\n  await page1.getByRole('link', { name: '大道路' }).click();\n  await page1.getByText('全家大道店 台北市信義區大道路79號').click();\n  await page1.getByRole('link', { name: '確定店舖' }).click();\n  await page.locator('#PayerName').click();\n  await page.locator('.receiver').first().check();\n  await page.locator('#PayerName').click();\n  await page.locator('#PayerName').fill(testData('姓名'));\n  await page.locator('#PayerTel').click();\n  await page.locator('#PayerTel').fill(testData('電話'));\n  await page.locator('select[name=\"City\"]').selectOption(testData('City'));\n  await page.locator('#PayerAddrTemp').click();\n  await page.locator('#PayerAddrTemp').fill(testData('地址'));\n  await page.locator('#PayerMail').click();\n  await page.locator('#PayerMail').fill(testData('Email'));\n  await page.getByRole('checkbox', { name: '請再次確認您的「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至您的Email信箱' }).check();\n  await page.getByRole('link', { name: '已閱讀並同意服務條款，確認送出' }).click();\n});",

  "note": "",
  "region_id": "production",
  "script": "import { test, expect } from '@playwright/test';\n\ntest.use({\n  locale: 'zh-TW'\n});\n\ntest('test', async ({ page }) => {\n  await page.goto('https://core.newebpay.com/EPG/MS1118308/t76lRq');\n  await page.getByRole('img', { name: 'AFTEE' }).click();\n  await page.getByRole('radio', { name: '分期付款' }).check();\n  await page.locator('#aftee_insttimes').selectOption(testData('aftee_insttimes'));\n  await page.getByRole('button', { name: '超商取貨' }).click();\n  await page.getByRole('radio', { name: '全家' }).check();\n  const page1Promise = page.waitForEvent('popup');\n  await page.getByRole('button', { name: '選擇取貨門市' }).click();\n  const page1 = await page1Promise;\n  await page1.getByRole('link', { name: '台北市' }).click();\n  await page1.getByRole('link', { name: '大同區' }).click();\n  await page1.getByRole('link', { name: '長安西路' }).click();\n  await page1.getByRole('cell', { name: '全家長慶店 台北市大同區長安西路258號1樓', exact: true }).click();\n  await page1.getByRole('link', { name: '確定店舖' }).click();\n  await page.locator('#PayerName').click();\n  await page.locator('#PayerName').fill(testData('姓名'));\n  await page.locator('#PayerName').press('Tab');\n  await page.locator('#PayerTel').fill(testData('電話'));\n  await page.locator('#PayerMail').click();\n  await page.locator('#PayerMail').fill(testData('Email'));\n  await page.locator('.receiver').first().check();\n  await page.getByRole('checkbox', { name: '請再次確認您的「訂單資訊」及「付款資訊」，付款完成後藍新金流將發送通知信至您的Email信箱' }).check();\n  await page.getByRole('link', { name: '已閱讀並同意服務條款，確認送出' }).click();\n});",
